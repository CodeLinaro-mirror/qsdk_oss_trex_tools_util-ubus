#!/bin/sh

. /usr/share/libubox/jshn.sh
. /usr/sbin/pots_status.sh
if [ -f /usr/sbin/pots_status_calix.sh ]; then
	. /usr/sbin/pots_status_calix.sh
	support_proprietary="1"
fi

case "$1" in
	list)
		json_init
		json_add_object hook_state
		json_add_string name "pots name"
		json_close_object
		json_add_object sip_status
		json_add_string name "pots name"
		json_close_object
		json_add_object voip_line_status
		json_add_string name "pots name"
		json_close_object
		if [ x"$support_proprietary" == x"1" ]; then
			proprietary_object_list
		fi
		json_dump
		;;

	call)
		case "$2" in
			hook_state)
				# read the arguments
				read input;

				# parse input data
				NAME=$(echo ${input}  | sed 's/"\"//g'| sed 's/{"name":/@/g'| sed 's/",//g' | sed 's/"/ /g' |awk '{print $2}' )
				get_hookstate $NAME # ME 53
				;;

			sip_status)
				# read the arguments
				read input;

				# parse input data
				NAME=$(echo ${input}  | sed 's/"\"//g'| sed 's/{"name":/@/g'| sed 's/",//g' | sed 's/"/ /g' |awk '{print $2}' )
				get_sipstatus $NAME # ME 150
				;;

			voip_line_status)
				# read the arguments
				read input;

				# parse input data
				NAME=$(echo ${input}  | sed 's/"\"//g'| sed 's/{"name":/@/g'| sed 's/",//g' | sed 's/"/ /g' |awk '{print $2}' )
				get_voiplinestatus $NAME # ME141
				;;

			*)
				# read the arguments
				read input;

				# parse input data
				NAME=$(echo ${input}  | sed 's/"\"//g'| sed 's/{"name":/@/g'| sed 's/",//g' | sed 's/"/ /g' |awk '{print $2}' )
				if [ x"$support_proprietary" == x"1" ]; then
					proprietary_call $2 $NAME
				fi
				;;
		esac
		;;
esac
